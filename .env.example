TELEGRAM_BOT_TOKEN=put_your_botfather_token_here

# Multiple Gemini API keys (comma-separated) for round-robin load balancing & failover:
GEMINI_API_KEYS=key1,key2,key3
# Or a single key:
# GEMINI_API_KEY=your_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/xeon_ai

# Optional settings
MAX_HISTORY=20
